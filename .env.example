# Application
NODE_ENV=development

# URL Shortener
# Use port 5173 for development, 3000 for production (docker)
PUBLIC_URL=http://localhost:5173

# Relative SQLite paths are resolved from libs/engine/prisma/
DATABASE_URL=file:./dev.db

CREATION_RATE_LIMIT=10
CREATION_RATE_WINDOW_MS=60000
CLICK_RECORDING_TIMEOUT_MS=1000
