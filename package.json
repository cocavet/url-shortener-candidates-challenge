{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @url-shortener/engine db:generate",
    "db:migrate": "pnpm --filter @url-shortener/engine db:migrate",
    "test": "pnpm db:generate && vitest run",
    "test:watch": "pnpm db:generate && vitest",
    "test:e2e": "pnpm build && playwright test",
    "clean": "turbo run clean && rm -rf .turbo",
    "clean:deep": "pnpm run clean && pnpm -r exec rm -rf node_modules && rm -rf node_modules"
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2",
    "turbo": "^2.7.4",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  }
}
